\newlabel{sec:results-specificity}{{5.1}{6}{Specificity: False Alarms on Behavioural No-Ops}{subsection.5.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces False-alarm rate versus sensitivity for all 32 candidate readouts on the specificity panel. Each point is one readout; color indicates readout class (blue = activation, orange = logit, green = weight, red = text/card). Activation readouts cluster in the low-false-alarm region (0--3/15); logit baselines scatter across 5--8/15; the weight-space cosine B7 has the most false alarms (9/15). No readout achieves both zero false alarms and high sensitivity.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:specificity}{{2}{7}{False-alarm rate versus sensitivity for all 32 candidate readouts on the specificity panel. Each point is one readout; color indicates readout class (blue = activation, orange = logit, green = weight, red = text/card). Activation readouts cluster in the low-false-alarm region (0--3/15); logit baselines scatter across 5--8/15; the weight-space cosine B7 has the most false alarms (9/15). No readout achieves both zero false alarms and high sensitivity}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Displacement Analysis}{7}{subsection.5.2}\protected@file@percent }
\newlabel{sec:results-displacement}{{5.2}{7}{Displacement Analysis}{subsection.5.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces All 32 candidate readouts. FA = false alarms on 15 no-ops (12 non-degenerate in parentheses). Sens = sensitivity on 9 effective pairs (denominator varies where noted). Disp = median null-SD displacement on no-ops. Readout class: \textbf  {A} = activation, \textbf  {L} = logit, \textbf  {W} = weight, \textbf  {T} = text/card.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:specificity}{{2}{8}{All 32 candidate readouts. FA = false alarms on 15 no-ops (12 non-degenerate in parentheses). Sens = sensitivity on 9 effective pairs (denominator varies where noted). Disp = median null-SD displacement on no-ops. Readout class: \textbf {A} = activation, \textbf {L} = logit, \textbf {W} = weight, \textbf {T} = text/card}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Median no-op displacement (in null standard deviations) for each readout class. The logit baseline operates 6.2$\times $ further from zero than the median activation readout, explaining its higher false-alarm rate. Error bars show interquartile range across readouts within each class.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:displacement}{{3}{9}{Median no-op displacement (in null standard deviations) for each readout class. The logit baseline operates 6.2$\times $ further from zero than the median activation readout, explaining its higher false-alarm rate. Error bars show interquartile range across readouts within each class}{figure.3}{}}
