\@writefile{toc}{\contentsline {paragraph}{No site-local intervention changes judged refusal.}{9}{section*.8}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Causal grid: effect sizes (effect$_\text  {FR}$) for arm F on over-refusal (benign-borderline), instruct and SafeRL. Negative values = over-refusal decreases. * = survives Holm--Bonferroni. Cells marked -- are NOT\_RUN. Family size: 18 (instruct/SafeRL), 6 (abliterated, site P only). MDE$_{80}$: 0.067 (instruct), 0.061 (SafeRL).}}{9}{table.3}\protected@file@percent }
\newlabel{tab:causal}{{3}{9}{Causal grid: effect sizes (effect$_\text {FR}$) for arm F on over-refusal (benign-borderline), instruct and SafeRL. Negative values = over-refusal decreases. * = survives Holm--Bonferroni. Cells marked -- are NOT\_RUN. Family size: 18 (instruct/SafeRL), 6 (abliterated, site P only). MDE$_{80}$: 0.067 (instruct), 0.061 (SafeRL)}{table.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Token-1 moves but judged refusal does not.}{10}{section*.9}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Over-refusal is the causal lever.}{10}{section*.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Effect sizes for arm F on over-refusal (benign-borderline prompts) across the 6-band $\times $ 3-site causal grid. Left: Qwen3-4B-Instruct. Right: Qwen3-4B-SafeRL. Negative values (blue) indicate reduced over-refusal. The strongest effects concentrate at bands B4--B5, site P, but no cell survives Holm--Bonferroni correction for judged refusal on harmful prompts.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:causal_grid}{{4}{10}{Effect sizes for arm F on over-refusal (benign-borderline prompts) across the 6-band $\times $ 3-site causal grid. Left: Qwen3-4B-Instruct. Right: Qwen3-4B-SafeRL. Negative values (blue) indicate reduced over-refusal. The strongest effects concentrate at bands B4--B5, site P, but no cell survives Holm--Bonferroni correction for judged refusal on harmful prompts}{figure.4}{}}
