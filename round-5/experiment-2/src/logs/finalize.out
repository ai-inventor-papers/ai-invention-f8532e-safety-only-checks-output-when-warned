# Disposition of every heavy path in this workspace. Exactly one decision each.
# Text and code files at any size, and anything under the 10 MB auto-keep floor,
# need no entry and are not listed.
entries:
  - path: .venv_gpu/
    delete: regenerable
    source: "bash logs/build_venv.sh   # uv venv --python 3.12 .venv_gpu && uv pip install --python .venv_gpu/bin/python --extra-index-url https://download.pytorch.org/whl/cu128 --index-strategy unsafe-best-match -r env/requirements_gpu.txt"

  - path: arrays/
    keep: >-
      The deliverable. Per-layer residual activations, per-checkpoint direction banks and the
      forward-only intervention grid for every gated checkpoint -- hours of GPU time, and not
      reproducible inside this run because each tag's HF snapshot is deleted after its visit.

  - path: private/
    delete: regenerable
    source: "bash logs/relaunch.sh   # regenerates raw completions; DELETED before this artifact finishes because it holds raw model output on harmful prompts plus edited weights"

  - path: src/__pycache__/
    delete: regenerable
    source: "automatically recreated by any python run"

